# 删除 Ensembl ID 中的版本号
eset_stad$Ensembl_ID<-substring(eset_stad$Ensembl_ID, 1, 15)
eset_stad<-column_to_rownames(eset_stad, var = "Ensembl_ID")    

#恢复到原始格式，因为来自 UCSC 的数据已经过 log2(x+1)转换。
